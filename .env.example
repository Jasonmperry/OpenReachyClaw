# === LLM Configuration ===
# Voice pipeline requires OpenAI Realtime API:
OPENAI_API_KEY=sk-...

# Text brain can use OpenAI or a local Ollama instance:
# For Ollama, set:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENREACHYCLAW_TEXT_MODEL=gemma3:4b
# For OpenAI (default), leave OPENAI_BASE_URL unset.
# OPENAI_BASE_URL=
# OPENREACHYCLAW_TEXT_MODEL=gpt-4o

# === Gemini (for nano_banana image style transfer) ===
# GEMINI_API_KEY=

# === Profile ===
REACHY_MINI_CUSTOM_PROFILE=rosie
REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=./profiles
REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=./openreachyclaw/tools
AUTOLOAD_EXTERNAL_TOOLS=1

# === OpenClaw (text channels) ===
OPENCLAW_URL=http://localhost:3000
OPENCLAW_CALLBACK_PORT=8100

# === Conversation History ===
# OPENREACHYCLAW_HISTORY_MAX=40
# OPENREACHYCLAW_HISTORY_TTL=7200

# === Persistent Data ===
# Memory, face photos, and logs are stored in ~/.rosie/
# Override with: ROSIE_DATA_DIR=~/.rosie

# === Optional: HuggingFace (for gated models) ===
# HF_TOKEN=
